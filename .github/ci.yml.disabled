# CI workflow (disabled).
# To enable: move this file to `.github/workflows/ci.yml`.
# It was placed here because pushing files under `.github/workflows/` requires a
# GitHub token with the `workflow` OAuth scope. Enabling via the GitHub web UI
# (Add file → paste as .github/workflows/ci.yml) or re-authing `gh` with
# `-s workflow` both work.

name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  quality:
    name: Typecheck & Lint
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Typecheck
        run: npm run typecheck

      - name: Lint
        run: npm run lint
