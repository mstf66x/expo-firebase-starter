# Fastlane for an Expo (bare/dev-build) app — no EAS.
# Native projects (ios/, android/) are generated by `expo prebuild`, so each lane
# regenerates them via the scripts in ../scripts before building.
#
# Secrets are never committed: bundle IDs, team IDs, key paths and the match repo
# URL all come from env. See fastlane/README.md for the full list.

default_platform(:ios)

IOS_BUILD_SCRIPT     = '../scripts/build-ipa.sh'.freeze
ANDROID_BUILD_SCRIPT = '../scripts/build-aab.sh'.freeze
AAB_PATH             = '../android/app/build/outputs/bundle/release/app-release.aab'.freeze

# App Store Connect API key (preferred over Apple ID + password).
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV['ASC_KEY_ID'],
    issuer_id: ENV['ASC_ISSUER_ID'],
    key_filepath: ENV['ASC_KEY_PATH'],
    in_house: false
  )
end

platform :ios do
  desc 'Prebuild native iOS project, install pods, and build a signed IPA'
  lane :build do
    sh(IOS_BUILD_SCRIPT)
    match(type: 'appstore', readonly: true)
    build_app(export_method: 'app-store', xcargs: '-allowProvisioningUpdates')
  end

  desc 'Build and upload to TestFlight'
  lane :beta do
    api_key = asc_api_key
    build
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc 'Sync signing certificates & profiles (run once per machine)'
  lane :certs do
    match(type: 'appstore', readonly: false)
  end
end

platform :android do
  desc 'Prebuild native Android project and build a signed AAB'
  lane :build do
    sh(ANDROID_BUILD_SCRIPT)
  end

  desc 'Build and upload to the Play internal testing track'
  lane :internal do
    build
    upload_to_play_store(track: 'internal', aab: AAB_PATH, release_status: 'draft')
  end

  desc 'Build and upload to the Play beta (open/closed testing) track'
  lane :beta do
    build
    upload_to_play_store(track: 'beta', aab: AAB_PATH)
  end
end
