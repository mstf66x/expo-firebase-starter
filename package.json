{
  "name": "expo-firebase-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "Production-ready Expo (React Native) + Firebase starter kit for solo devs: native Firestore, Auth & Analytics, Expo Router, TypeScript, NativeWind (Tailwind), Zustand and Fastlane — no EAS required.",
  "keywords": [
    "expo",
    "react-native",
    "firebase",
    "firestore",
    "firebase-auth",
    "firebase-analytics",
    "expo-router",
    "typescript",
    "nativewind",
    "tailwindcss",
    "zustand",
    "fastlane",
    "boilerplate",
    "starter-kit",
    "template",
    "solo-developer",
    "mobile",
    "ios",
    "android"
  ],
  "homepage": "https://github.com/mstf66x/expo-firebase-starter#readme",
  "bugs": {
    "url": "https://github.com/mstf66x/expo-firebase-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mstf66x/expo-firebase-starter.git"
  },
  "license": "MIT",
  "author": "mustafa",
  "dependencies": {
    "@expo/ui": "~57.0.7",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-firebase/analytics": "^25.1.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/auth": "^25.1.0",
    "@react-native-firebase/firestore": "^25.1.0",
    "expo": "~57.0.7",
    "expo-build-properties": "~57.0.6",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "ios:beta": "bundle exec fastlane ios beta",
    "android:beta": "bundle exec fastlane android beta",
    "android:internal": "bundle exec fastlane android internal"
  },
  "private": true
